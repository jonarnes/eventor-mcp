# Required: secret API key from your Eventor organisation settings (long hex / GUID string).
EVENTOR_API_KEY=

# Base URL (Norway default)
EVENTOR_BASE_URL=https://eventor.orientering.no

# Name of the HTTP header that carries the key — usually the word ApiKey, NOT the key value.
# See the Eventor API PDF guide if your federation documents a different header.
EVENTOR_API_KEY_HEADER=ApiKey

# HTTP timeouts (seconds)
EVENTOR_TIMEOUT_SECONDS=30.0

# Response cache (reduces repeated calls)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=256

# Logging
LOG_LEVEL=INFO
LOG_DIR=
LOG_ROTATION_WHEN=midnight
LOG_BACKUP_COUNT=14

# Statistics / summary tool guardrails
STATS_MAX_DATE_RANGE_DAYS=730
STATS_MAX_EVENTS_IN_SUMMARY=500

# Required for remote HTTP MCP (serve-sse, serve-http only); independent of Eventor API key.
# EVENTOR_MCP_PUBLIC_URL is the HTTPS origin (scheme + host, no path).
# Also used so MCP library DNS-rebinding checks accept the public Host header (e.g. emcp.ijas.no behind Traefik).
EVENTOR_MCP_BEARER_TOKEN=
EVENTOR_MCP_PUBLIC_URL=

# Coolify / PaaS: often set automatically. Traefik loadbalancer.server.port must match.
# PORT=8000

# Resource limits (per process; applies to all tools and CLI API calls)
API_MAX_DATE_RANGE_DAYS=730
API_MAX_RESPONSE_BYTES=4000000
API_MAX_CONCURRENT_REQUESTS=4
API_REQUESTS_PER_MINUTE=60
CACHE_MAX_BYTES=32000000

# Explicit opt-in for unauthenticated loopback HTTP development only.
# Keep false for Coolify/public deployments. Local stdio never needs HTTP auth.
ALLOW_INSECURE_HTTP=false
